from .keywords.longPressV2.AppiumLongPressExtensions import AppiumLongPressExtensions
from .keywords.pinch.GesturePinch import GesturePinch
from .keywords.scroll.scroll import Scroll
from .keywords.scroll_to_element.ScrollToElement import ScrollToElement
from .keywords.swipe.swipe import Swipe
from .keywords.tap_at_percentage.TapAtPercentage import TapAtPercentage
from .keywords.TerminateApplication.TerminateApplicationExtension import TerminateApplicationExtension
from .keywords.wait_multiple_elements.WaitMultipleElements import WaitMultipleElements
from .keywords.zoom.GestureZoom import GestureZoom

class ProjetoKeywords(
    ChangeTheme,
    Appiumclick,
    ClickElements,
    ScreenshotComparisonKeywords,
    NetworkStatus,
    VisibleElements,
    AppiumLongPressExtensions,
    GesturePinch,
    Scroll,
    ScrollToElement,
    Swipe,
    TapAtPercentage,
    TerminateApplicationExtension,
    WaitMultipleElements,
    GestureZoom
):
    """
    Classe agregadora das keywords do projeto.

    Todas as keywords das classes herdadas ficam disponíveis para o Robot Framework.
    Basta importar esta biblioteca para ter acesso a todas as funcionalidades dos módulos.
    """
    ROBOT_LIBRARY_SCOPE = 'TEST SUITE'  # Define o escopo da biblioteca para cada suíte de teste
    ROBOT_LIBRARY_VERSION = '1.0'       # Versão da biblioteca

    def __init__(self):
        # Inicializa todas as classes base (keywords) com tratamento de erro
        for base in self.__class__.__bases__:
            try:
                base.__init__(self)
            except Exception as e:
                # Mensagem de erro detalhada para facilitar diagnóstico
                raise RuntimeError(f"Erro ao inicializar a classe base '{base.__name__}': {e}")

    @keyword("Keyword Exemplo da Biblioteca Principal")
    def exemplo_keyword_principal(self):
        """
        Exemplo de keyword definida diretamente na classe agregadora.
        Pode ser usada para utilidades gerais ou para centralizar funções comuns.
        """
        print("Esta keyword está na classe agregadora.")
